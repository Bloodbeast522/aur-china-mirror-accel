# pip 全局镜像配置 — 解决 AUR Python 包构建时 pip 直连 PyPI 被墙
#
# 背景: 很多 AUR 包(如 searxng-git)的 package() 会创建 venv 并
# pip install -r requirements.txt。直连 PyPI 在国内会被重置
# (ConnectionResetError 104)。改 PKGBUILD 加镜像不持久(paru 每次
# 重新克隆 PKGBUILD),但 pip 用户级配置对所有 venv 都生效。
#
# 安装: 复制到 ~/.config/pip/pip.conf(用户级,所有 venv 的 pip 自动读取)
# 验证: python3 -c "import configparser; print(configparser.ConfigParser().read('$HOME/.config/pip/pip.conf'))"

[global]
index-url = https://pypi.tuna.tsinghua.edu.cn/simple
trusted-host = pypi.tuna.tsinghua.edu.cn
