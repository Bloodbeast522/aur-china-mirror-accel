#!/usr/bin/env bash
# git wrapper for China networks — auto partial-clone for makepkg --mirror clones
#
# Problem: makepkg clones AUR -git sources with `git clone --mirror`, which
# fetches ALL refs incl. hundreds of refs/pull/* — multi-hundred-MB packs that
# stall on CN ghproxy mirrors. Verified on searxng (117MB repo): never finished
# even on ghfast.top; with --filter=blob:none → 17MB in 18s.
#
# Fix:
#  1. `clone --mirror` → append `--filter=blob:none` (partial clone: commits +
#     trees only, ~10x smaller).
#  2. makepkg's 2nd step `git clone -s <mirror> <work>` — the shared clone's
#     checkout FAILS because the mirror lacks blobs, and its remote points at
#     the LOCAL mirror (can't fetch missing blobs). After the clone, re-point
#     the work copy's promisor at the ORIGINAL upstream URL and re-run the
#     checkout so blobs are fetched on demand through the ghproxy insteadOf
#     rule. Verified live 2026-08-02 on searxng-git: 989/989 files.
#
# Only intercepts clone; everything else passes through verbatim.

REAL_GIT="${HERMES_REAL_GIT:-/usr/bin/git}"

# Fast path: not a clone subcommand → passthrough
case " $* " in
  *" clone "*) : ;;
  *" clone"*) : ;;
  *) exec "$REAL_GIT" "$@" ;;
esac

# --- clone command ---

# 1) --mirror → add partial-clone filter (makepkg step 1)
if [[ " $* " == *" --mirror "* ]]; then
  exec "$REAL_GIT" "$@" --filter=blob:none
fi

# 2) -s / --shared clone → run (tolerate checkout failure), then re-point
#    work-copy promisor at the original upstream and re-checkout
if [[ " $* " == *" -s "* || " $* " == *" --shared "* ]]; then
  # last two non-option args = <src> <dst>
  nonopts=()
  for a in "$@"; do
    case "$a" in
      -*|--*) : ;;
      *) nonopts+=("$a") ;;
    esac
  done
  src="${nonopts[-2]:-}"
  dst="${nonopts[-1]:-}"

  # Shared clone; checkout may fail on a partial mirror — that's expected.
  "$REAL_GIT" "$@" 2>/dev/null
  clone_rc=$?

  fixed=0
  if [[ -n "$src" && -n "$dst" && -d "$dst/.git" ]] && \
     git -C "$src" config --get remote.origin.promisor >/dev/null 2>&1; then
    orig_url="$(git -C "$src" config --get remote.origin.url 2>/dev/null)"
    if [[ -n "$orig_url" ]]; then
      git -C "$dst" remote set-url origin "$orig_url" 2>/dev/null
      git -C "$dst" config remote.origin.promisor true 2>/dev/null
      git -C "$dst" config remote.origin.partialclonefilter blob:none 2>/dev/null
      # Re-run checkout so missing blobs are fetched on demand from upstream.
      if git -C "$dst" checkout -f 2>/dev/null || \
         git -C "$dst" restore --source=HEAD :/ 2>/dev/null; then
        fixed=1
        echo "[git-wrapper] partial-clone work copy fixed: promisor → $orig_url" >&2
      fi
    fi
  fi

  # If we fixed the checkout, the clone effectively succeeded — report success
  # so makepkg's `git clone -s` step passes. Otherwise propagate the real rc.
  if [[ $fixed -eq 1 ]]; then
    exit 0
  fi
  exit $clone_rc
fi

exec "$REAL_GIT" "$@"
